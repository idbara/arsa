# Supabase (required)
PUBLIC_SUPABASE_URL=your-project-url
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server-only (Phase 5+ — market scraper worker)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (receipt storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=arsa-receipts

# Cloudflare Workers AI (receipt OCR)
CLOUDFLARE_AI_TOKEN=your-cloudflare-ai-api-token

# Resend (Phase 6+ — email reports)
# RESEND_API_KEY=your-resend-api-key

# Push Notifications (Phase 7+ — generate with: npx web-push generate-vapid-keys)
# PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
