{
	"name": "arsa-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --max-http-header-size=65536 node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "node --max-http-header-size=65536 node_modules/vite/bin/vite.js preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/eslint__js": "^8.42.3",
		"@types/papaparse": "^5.5.2",
		"daisyui": "^5.5.19",
		"dotenv": "^17.3.1",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.4.0",
		"jsdom": "^28.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.0",
		"sharp": "^0.34.5",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"web-push": "^3.6.7"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1001.0",
		"@aws-sdk/s3-request-presigner": "^3.1001.0",
		"@supabase/ssr": "^0.9.0",
		"@supabase/supabase-js": "^2.98.0",
		"idb": "^8.0.3",
		"papaparse": "^5.5.3",
		"workbox-expiration": "^7.4.0",
		"workbox-precaching": "^7.4.0",
		"workbox-routing": "^7.4.0",
		"workbox-strategies": "^7.4.0"
	}
